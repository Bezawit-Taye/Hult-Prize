# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Resend Email Delivery Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Sender address configured in Resend (use onboarding@resend.dev during testing)
# Once your custom domain is verified in Resend, use e.g. "HULT PRIZE AASTU <info@yourdomain.com>"
EMAIL_FROM="HULT PRIZE AASTU <onboarding@resend.dev>"

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
